{% extends "layout/private.j2" %}
{% from "macros/_poster_card.j2" import poster_card %}

{% macro render_field(field, extra_class="", label=None) %}
    <div class="mb-4">
        {% if label %}
            {{ field.label(text=label, class="block text-sm font-medium text-gray-700 mb-1") }}
        {% else %}
            {{ field.label(class="block text-sm font-medium text-gray-700 mb-1") }}
        {% endif %}
        {{ field(class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 " + extra_class + (" border-red-500" if field.errors else "")) }}
        {% if field.errors %}
            <div class="mt-1 text-sm text-red-600">
                {% for error in field.errors %}<span>{{ error }}</span>{% endfor %}
            </div>
        {% endif %}
    </div>
{% endmacro %}

{% macro render_checkbox(field) %}
    <label class="inline-flex items-center mb-4">
        {{ field(class="rounded border-gray-300 text-blue-600 focus:ring-blue-500") }}
        <span class="ml-2 text-sm text-gray-700">{{ field.label.text }}</span>
    </label>
{% endmacro %}

{% macro render_multi(field) %}
    <div class="mb-4">
        {{ field.label(class="block text-sm font-medium text-gray-700 mb-1") }}
        {{ field(class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500",
        size=4) }}
        <p class="mt-1 text-xs text-gray-500">
            Maintenez Cmd (macOS) ou Ctrl (Windows) pour sélectionner
            plusieurs entrées.
        </p>
        {% if field.errors %}
            <div class="mt-1 text-sm text-red-600">
                {% for error in field.errors %}<span>{{ error }}</span>{% endfor %}
            </div>
        {% endif %}
    </div>
{% endmacro %}

{% macro common_filters(salary_min_label, salary_max_label, remote_fields) %}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {{ render_field(form.sector) }}
        {{ render_field(form.contract_type) }}
        {{ render_field(form.starting_date) }}
        {{ render_field(form.ending_date) }}
        {{ render_field(form.salary_min, extra_class="no-spinner", label=salary_min_label) }}
        {{ render_field(form.salary_max, extra_class="no-spinner", label=salary_max_label) }}
        {{ render_field(form.partial_time, extra_class="no-spinner !w-32") }}
    </div>
    <div class="flex gap-4">
        {{ render_checkbox(form.full_time) }}
        {% for remote_field in remote_fields %}
            {{ render_checkbox(remote_field) }}
        {% endfor %}
    </div>
{% endmacro %}

{% block content %}
{# Hide browser spin buttons on numeric inputs marked .no-spinner
   (salary fields). Ref bug #0073. #}
    <style>
        input.no-spinner::-webkit-outer-spin-button,
        input.no-spinner::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input.no-spinner { -moz-appearance: textfield; }
        [x-cloak] { display: none !important; }
    </style>
    <div class="py-10">
        <div class="mx-auto max-w-3xl px-6">
            <h1 class="text-2xl font-semibold text-gray-800 mb-6">
                Publier une offre d'emploi
            </h1>
            <p class="text-sm text-gray-600 mb-6">
                Remplissez le formulaire ci-dessous pour publier votre offre
                d'emploi. Elle s'affichera dans l'espace MARKET / Job Board et les
                candidatures apparaîtront dans votre espace WORK / OPPORTUNITÉS /
                Jobs sous forme de notifications.
            </p>
            <form method="post"
                  x-data="{ statut: '{{ form.statut.data or '' }}' }"
                  class="bg-white p-6 rounded-lg shadow">
                {{ render_field(form.title) }}
                {{ render_field(form.description, extra_class="min-h-[160px]") }}
                <div class="mb-4">
                    {{ form.statut.label(class="block text-sm font-medium text-gray-700 mb-1") }}
                    {{ form.statut(
                    class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500",
                    **{"x-model": "statut"}
                    ) }}
                </div>

                {# Formulaire Étudiant #}
                <template x-if="statut === 'STATUT / Etudiant.e'">
                    <div class="border-t border-gray-200 pt-4 mt-2">
                        <p class="text-sm font-medium text-gray-700 mb-3">
                            Fiche descriptive (réservée aux offres Étudiant)
                        </p>
                        {{ render_field(form.domain_studient) }}
                        {{ render_field(form.type_emploi_pro_studient) }}
                        {{ render_field(form.niveau_etude) }}
                        {{ render_multi(form.matiere_etudiee) }}
                        {{ render_multi(form.langues) }}
                        {{ common_filters("Rémunération min (€ brut/mois)", "Rémunération max (€ brut/mois)", [form.remote_ok]) }}
                    </div>
                </template>

                {# Formulaire Professionnel #}
                <template x-if="statut === 'STATUT / Professionnel.le'">
                    <div class="border-t border-gray-200 pt-4 mt-2"
                         x-data="{ domain_pro: '{{ form.domain_pro.data or '' }}' }">
                        <p class="text-sm font-medium text-gray-700 mb-3">
                            Fiche descriptive (réservée aux offres Professionnel)
                        </p>
                        <div class="mb-4">
                            {{ form.domain_pro.label(class="block text-sm font-medium text-gray-700 mb-1") }}
                            {{ form.domain_pro(
                            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500",
                            **{"x-model": "domain_pro"}
                            ) }}
                        </div>

                        {# Journalisme #}
                        <template x-if="domain_pro === 'JOB BOARD / PRO / Journalisme'">
                            <div>
                                {{ render_field(form.type_emploi_pro_journaliste) }}
                                {{ render_multi(form.competence_journalisme) }}
                            </div>
                        </template>

                        {# Communication #}
                        <template x-if="domain_pro === 'JOB BOARD / PRO / Communication'">
                            <div>
                                {{ render_field(form.type_emploi_pro_communicant) }}
                                {{ render_multi(form.competence_relation_presse) }}
                            </div>
                        </template>

                        {# Innovation #}
                        <template x-if="domain_pro === 'JOB BOARD / PRO / Innovation'">
                            <div>
                                {{ render_field(form.type_emploi_pro_innovation) }}
                                {{ render_multi(form.competence_innovation) }}
                            </div>
                        </template>

                        {{ render_field(form.niveau_etude) }}
                        {{ render_multi(form.langues) }}
                        {{ common_filters("Rémunération min (€ brut/an)", "Rémunération max (€ brut/an)", [form.remote_partial_time, form.remote_full_time]) }}
                    </div>
                </template>

                <div x-show="statut" x-cloak class="border-t border-gray-200 pt-4 mt-2">
                    <div class="mb-4">
                        {{ form.pays_zip_ville.label(class="block text-sm font-medium text-gray-700 mb-1") }}
                        {{ form.pays_zip_ville() }}
                    </div>
                </div>

                <div class="mt-6">
                    {{ poster_card(
                    g.user,
                    title="Information de contact",
                    footer="Les candidatures vous parviendront par notification et par e-mail. Votre profil s'affichera sur l'annonce."
                    ) }}
                </div>
                <div class="flex space-x-3 mt-6">
                    <button type="submit"
                            class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md">
                        Publier
                    </button>
                    <a href="{{ url_for('biz.biz', current_tab='jobs') }}"
                       class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium py-2 px-4 rounded-md">
                        Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
