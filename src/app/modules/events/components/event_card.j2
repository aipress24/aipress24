{# `class_` est appliqué ici. Le champ existait sur le composant —
   ajouté pour que l'onglet Événements d'une organisation cesse de
   renvoyer un 500 sur un mot-clé inattendu — mais le gabarit ne le
   lisait pas : le `bg-gray-100` que passe ce site d'appel n'a jamais
   rien fait. Le liseré du Wall (lot `C8`) s'en servait aussi ; les
   événements ont quitté le Wall le 2026-09-01, l'onglet des
   organisations reste. #}
<li class="card shadow rounded p-0 bg-white mt-4 space-y-4 {{ class_ }}">
  <div class="pt-4 px-4 flex flex-col justify-between">
    <div>
      {# §7.1 — la mention « Accrédité.e » va en haut, tout à droite,
         sur la ligne date/heure. #}
      <div class="text-sm text-gray-700 flex items-start justify-between gap-2">
        <div>
          {# MOD-03 — le pictogramme du mode, lu **directement sur le
             modèle**. La carte est rendue à deux profondeurs
             d'enveloppe : `EventCardVM(EventListVM(EventPost))` sur la
             liste, `EventCardVM(EventPost)` sur le Business Wall d'une
             organisation. Tout ce qu'`EventListVM` calcule est
             `Undefined` — donc faux, sans erreur — sur le second
             chemin. C'est ce qui fait que la pastille « Accrédité.e »
             n'y apparaît toujours pas. #}
          {% if event.mode == "hybrid" %}
            {{ icon("building-office", class="inline h-4 w-4 text-gray-500", title="Hybride") }}
            {{ icon("video-camera", class="inline h-4 w-4 text-gray-500", title="Hybride") }}
          {% elif event.mode == "online" %}
            {{ icon("video-camera", class="inline h-4 w-4 text-gray-500", title="En distanciel") }}
          {% elif event.mode == "phone" %}
            {{ icon("phone", class="inline h-4 w-4 text-gray-500", title="Par téléphone") }}
          {% else %}
            {{ icon("building-office", class="inline h-4 w-4 text-gray-500", title="En présentiel") }}
          {% endif %}
          {{event.opening}}
        </div>
        <div class="shrink-0 flex items-center gap-2">
          {# PRX-04 — le tarif, tel que ce lecteur doit le lire. #}
          <span class="inline-flex items-center rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">
            {{ event.price_label }}
          </span>
          {% if event.is_accredited %}
            <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">
              Accrédité.e
            </span>
          {% endif %}
        </div>
      </div>

      {% if event.cancelled_at %}
        <p class="mt-1 inline-flex items-center rounded bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">
          Événement annulé
        </p>
      {% endif %}

      <a href="{{ url_for(event) }}">
        <h2 class="text-lg font-medium{% if event.cancelled_at %} line-through{% endif %}">
          {{ event.title }}
        </h2>
      </a>

      {% if event.cancelled_at and event.cancellation_reason %}
        <p class="text-sm text-red-700">{{ event.cancellation_reason }}</p>
      {% endif %}
    </div>
  </div>

  <div class="px-4 flex justify-between">
    <div class="text-sm text-gray-800">
      {{ event.summary }}
    </div>
  </div>

  <div class="px-4">
    {# Bug 0138: in the delegated case (author org ≠ publisher) the     #}
    {# italic "Publié par … en tant que contact presse de …" line says #}
    {# the client, so the "Pour : <client>" chip (#0129) is a redundant #}
    {# doublon — show the chip ONLY when the italic line is absent      #}
    {# (self-published / no client delegation), keeping #0129 intact.   #}
    {% set _delegated = event.author.organisation and event.publisher
          and event.author.organisation.id != event.publisher.id %}

    {# `flex flex-wrap gap-2` : l'espacement venait des blancs entre les
       balises, qui disparaissent au retour à la ligne — deux rangées de
       puces se touchaient. La gouttière ne dépend plus de l'indentation
       du gabarit.

       **Chaque puce est conditionnelle.** `.chip` est un `inline-flex`
       avec un padding : une valeur vide n'affichait pas « rien », elle
       affichait une pastille de couleur nue. `type_label` vaut `""` par
       défaut (`get_meta_attr`), et c'est ce qui mettait un ovale vert au
       début de presque chaque carte. #}
    <div class="flex flex-wrap items-center gap-2">
      {# Bug #0138: this type badge was a dead affordance — `href="#"` +
         `hx-post="" hx-target="#content"` with no `force-tab` handler
         anywhere; on the BW org page (no #content) clicking it did
         nothing, so the event never "developed" (no Participants, no
         accreditation block). Make it a real link to the event detail,
         like the title link — works on every host. #}
      {% if event.type_label %}
        <a href="{{ url_for(event) }}" class="chip ~positive @low">{{ event.type_label }}</a>
      {% endif %}

      {% if event.category %}
        <span class="chip ~neutral @low">{{ event.category }}</span>
      {% endif %}
      {% set _sector = event.sector.split("/")[-1]|trim %}
      {% if _sector %}
        <span class="chip ~neutral @low">{{ _sector }}</span>
      {% endif %}

      {% if event.publisher and not _delegated %}
        <span class="chip ~info @low">
          Pour : {{ event.publisher.bw_name or event.publisher.name }}
        </span>
      {% endif %}
    </div>

    {% if _delegated %}
      <div class="text-xs italic text-gray-500 mt-1">
        Publié par {{ event.author.organisation.name }} en tant que contact presse de {{ event.publisher.name }}.
      </div>
    {% endif %}
    {# ORG-03/ORG-04 — l'organisateur, **uniquement s'il a été désigné**.
       À vide la cascade retombe sur l'éditeur, et l'affichage doit
       rester exactement celui d'avant le lot (ORG-02) : sans cette
       garde, chaque carte du site changerait de libellé. #}
    {% if event.has_explicit_organiser %}
      <div class="text-xs text-gray-600 mt-1">
        Organisé par
        {% if event.organiser %}
          <a href="{{ url_for(event.organiser) }}" class="hover:underline">{{ event.organiser_label }}</a>
        {% else %}
          {{ event.organiser_label }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div>
    <hr/>

    <div class="px-4 py-2 flex items-center space-x-3">
      <div class="flex-shrink-0">
        <a href="{{ url_for(event.author) }}" class="focus:outline-none">
          {{ profile_image(event.author, size=10) }}
        </a>
      </div>

      <div class="flex-1 min-w-0">
        <a href="{{ url_for(event.author) }}" class="focus:outline-none">
          <p class="text-sm font-medium text-gray-900">
            {{ event.author.name }}
          </p>
          <p class="text-sm text-gray-500 truncate">
            {{ event.author.job_title }} @ {{ event.author.organisation_name }}
          </p>
        </a>
      </div>
    </div>

    <hr/>
  </div>

  <div class="px-4 py-2 flex justify-between space-x-8">
    <div class="flex space-x-6">
      <span class="inline-flex items-center text-sm">
        <button
            type="button"
            class="inline-flex space-x-2 text-gray-400 hover:text-gray-500"
            hx-post="{{ url_for(event) }}"
            hx-vals='{"action": "toggle-like"}'
            hx-target="#likes-{{ event.id }}"
            hx-swap="innerHTML"
        >
          {{ icon("star", class="h-5 w-5") }}
          <span id="likes-{{ event.id }}" class="font-medium text-gray-900">{{ event.likes }}</span>
          <span class="sr-only">likes</span>
        </button>
      </span>

      <a href="{{ url_for(event) }}#comments-title" class="inline-flex items-center text-sm">
          <span class="inline-flex space-x-2 text-gray-400">
            {{ icon("chat-bubble-left-ellipsis", class="h-5 w-5") }}
            <span class="font-medium text-gray-900">{{ event.replies }}</span>
            <span class="sr-only">replies</span>
          </span>
      </a>

      <span class="inline-flex items-center text-sm">
        <span class="inline-flex space-x-2 text-gray-400">
          {{ icon("eye", class="h-5 w-5") }}
          <span class="font-medium text-gray-900">{{ event.views }}</span>
          <span class="sr-only">views</span>
        </span>
      </span>
    </div>

    <div class="flex text-sm">
      <span class="inline-flex items-center text-sm">
        <button
            type="button"
            class="inline-flex space-x-2 text-gray-400 hover:text-gray-500"
        >
          {{ icon("share", class="h-5 w-5") }}
        </button>
      </span>
    </div>
  </div>
</li>
