{% extends "wip/layout/_base.j2" %}

{% block body_content %}
  <script>
    const DATA = {{ page_data|tojson }};
  </script>

  <div>
    <canvas id="myChart"></canvas>
  </div>

  <script>
    const config = {
      type: 'line',
      data: DATA,
      options: {
        scales: {
          y: {
            beginAtZero: true,
          },
        },
      },
    };

    // Chart comes from the bundle, a module script that runs before
    // DOMContentLoaded.
    document.addEventListener('DOMContentLoaded', () => {
      new Chart(document.getElementById('myChart'), config);
    });
  </script>

{% endblock %}
