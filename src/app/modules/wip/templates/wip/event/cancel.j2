{% extends "wip/layout/_base.j2" %}

{% block body_content %}
  {% if can_restore %}
    <h1 class="text-2xl font-semibold text-gray-900 mb-2">Rétablir l'événement</h1>
  {% else %}
    <h1 class="text-2xl font-semibold text-gray-900 mb-2">Annuler l'événement</h1>
  {% endif %}
  <p class="text-sm text-gray-600 mb-6">{{ event.title }}</p>

  {% if can_cancel %}
    <form method="POST"
          class="bg-white border border-gray-200 rounded shadow-sm p-6 space-y-6">
      <input type="hidden" name="_action" value="cancel-event">

      <p class="text-sm text-red-800 bg-red-50 border border-red-200 rounded p-4">
        {% if accredited_count %}
          {{ accredited_count }} personne(s) sont accréditées à cet événement.
          Elles seront prévenues par email et par notification.
        {% else %}
          Personne n'est encore accrédité à cet événement.
        {% endif %}
        L'annonce restera visible, barrée, avec la mention
        «&nbsp;Événement annulé&nbsp;». Aucune accréditation ne sera retirée.
      </p>

      <div>
        <label for="reason" class="block text-sm font-medium text-gray-900">
          Motif de l'annulation
          <span class="font-normal text-gray-500">(facultatif)</span>
        </label>
        <textarea id="reason"
                  name="reason"
                  rows="3"
                  maxlength="{{ max_reason }}"
                  class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm text-sm focus:border-pink-500 focus:ring-pink-500"
                  placeholder="Il sera affiché sur l'annonce et repris dans le message envoyé aux accrédités."></textarea>
        <p class="mt-1 text-xs text-gray-500">{{ max_reason }} signes au maximum.</p>
      </div>

      <p class="text-xs text-gray-500">
        Vous pourrez revenir sur cette annulation pendant 24&nbsp;heures.
        Passé ce délai, l'annulation est définitive&nbsp;: elle aura été
        annoncée, et on n'efface pas un message déjà reçu.
      </p>

      <div class="flex justify-end space-x-3">
        <a href="{{ url_for('EventsWipView:index') }}"
           class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
          Revenir
        </a>
        <button type="submit"
                class="rounded-md border border-transparent bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">
          Annuler l'événement
        </button>
      </div>
    </form>

  {% elif can_restore %}
    <form method="POST"
          class="bg-white border border-gray-200 rounded shadow-sm p-6 space-y-6">
      <input type="hidden" name="_action" value="restore-event">

      <p class="text-sm text-gray-800 bg-gray-50 border border-gray-200 rounded p-4">
        Cet événement a été annulé le {{ event.cancelled_at|localdt }}.
        {% if accredited_count %}
          Les {{ accredited_count }} personne(s) accréditées seront prévenues
          qu'il est finalement maintenu.
        {% endif %}
      </p>

      {% if event.cancellation_reason %}
        <p class="text-sm text-gray-600">
          Motif indiqué&nbsp;: {{ event.cancellation_reason }}
        </p>
      {% endif %}

      <div class="flex justify-end space-x-3">
        <a href="{{ url_for('EventsWipView:index') }}"
           class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
          Revenir
        </a>
        <button type="submit"
                class="rounded-md border border-transparent bg-pink-600 px-4 py-2 text-sm font-medium text-white hover:bg-pink-700">
          Rétablir l'événement
        </button>
      </div>
    </form>

  {% else %}
    <div class="bg-white border border-gray-200 rounded shadow-sm p-6 space-y-4">
      {% if event.cancelled_at %}
        <p class="text-sm text-gray-800">
          Cet événement a été annulé le {{ event.cancelled_at|localdt }}, il y a
          plus de 24&nbsp;heures. L'annulation a été annoncée aux personnes
          accréditées et ne peut plus être levée&nbsp;: créez un nouvel
          événement.
        </p>
      {% else %}
        <p class="text-sm text-gray-800">
          Seul un événement publié peut être annulé. Celui-ci est un brouillon
          — il n'a été annoncé à personne, il suffit de le modifier ou de le
          supprimer.
        </p>
      {% endif %}
      <a href="{{ url_for('EventsWipView:index') }}"
         class="inline-block rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Revenir
      </a>
    </div>
  {% endif %}
{% endblock %}
