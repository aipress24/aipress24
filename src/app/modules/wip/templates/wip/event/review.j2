{% extends "wip/layout/_base.j2" %}

{% block body_content %}
  {% if can_send_back %}
    <h1 class="text-2xl font-semibold text-gray-900 mb-2">Renvoyer à l'auteur</h1>
  {% else %}
    <h1 class="text-2xl font-semibold text-gray-900 mb-2">Soumettre à relecture</h1>
  {% endif %}
  <p class="text-sm text-gray-600 mb-6">{{ event.title }}</p>

  {% if can_submit %}
    <form method="POST"
          class="bg-white border border-gray-200 rounded shadow-sm p-6 space-y-6">
      <input type="hidden" name="_action" value="submit-for-review">

      {# Décision `C9-b` : le motif du dernier renvoi attend l'auteur là
         où il resoumet, au lieu de vivre dans sa seule cloche. #}
      {% if event.send_back_reason %}
        <div class="rounded-md border border-amber-300 bg-amber-50 p-4">
          <p class="text-sm font-medium text-amber-900">
            Cet événement vous avait été renvoyé
          </p>
          <p class="mt-1 text-sm text-amber-800 whitespace-pre-line">{{ event.send_back_reason }}</p>
        </div>
      {% endif %}

      <p class="text-sm text-gray-800">
        Votre organisation relit les événements avant publication. Une fois
        soumis, cet événement passe la main&nbsp;: vous ne pourrez plus le
        modifier tant qu'un relecteur ne vous l'aura pas renvoyé.
      </p>

      <p class="text-xs text-gray-500">
        Les mêmes contrôles qu'à la publication s'appliquent ici — titre,
        contenu, dates, adresse ou lien selon le format, prix si l'événement
        est payant. Un relecteur ne doit pas hériter d'un brouillon
        impubliable.
      </p>

      <div class="flex justify-end space-x-3">
        <a href="{{ url_for('EventsWipView:index') }}"
           class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
          Revenir
        </a>
        <button type="submit"
                class="rounded-md border border-transparent bg-pink-600 px-4 py-2 text-sm font-medium text-white hover:bg-pink-700">
          Soumettre à relecture
        </button>
      </div>
    </form>

  {% elif can_send_back %}
    <form method="POST"
          class="bg-white border border-gray-200 rounded shadow-sm p-6 space-y-6">
      <input type="hidden" name="_action" value="send-back">

      <div>
        <label for="comment" class="block text-sm font-medium text-gray-900">
          Motif du renvoi <span class="text-red-600">*</span>
        </label>
        <textarea id="comment"
                  name="comment"
                  rows="4"
                  required
                  class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm text-sm focus:border-pink-500 focus:ring-pink-500"
                  placeholder="Ce que l'auteur doit corriger avant de resoumettre."></textarea>
        <p class="mt-1 text-xs text-gray-500">
          Obligatoire&nbsp;: sans motif, l'auteur ne sait pas ce qu'il doit
          reprendre. Il lui sera transmis avec la notification.
        </p>
      </div>

      <div class="flex justify-end space-x-3">
        <a href="{{ url_for('EventsWipView:index') }}"
           class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
          Revenir
        </a>
        <button type="submit"
                class="rounded-md border border-transparent bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-700">
          Renvoyer à l'auteur
        </button>
      </div>
    </form>

  {% else %}
    <div class="bg-white border border-gray-200 rounded shadow-sm p-6 space-y-4">
      {% if not reviews %}
        <p class="text-sm text-gray-800">
          Votre organisation ne relit pas les événements avant publication.
          Vous pouvez publier directement depuis la liste.
        </p>
      {% else %}
        <p class="text-sm text-gray-800">
          Il n'y a rien à faire sur cet événement à ce stade&nbsp;: il n'est ni
          un brouillon que vous pourriez soumettre, ni en attente d'une
          relecture qui vous revienne.
        </p>
      {% endif %}
      <a href="{{ url_for('EventsWipView:index') }}"
         class="inline-block rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
        Revenir
      </a>
    </div>
  {% endif %}
{% endblock %}
