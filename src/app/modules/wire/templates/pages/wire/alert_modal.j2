{# Modal for conent alert #}
<div
    id="content-alert-modal"
    class="fixed inset-0 z-50 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="alert-modal-title"
>
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div
            class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"
            onclick="document.getElementById('content-alert-modal')?.remove()"
            aria-hidden="true"
        ></div>

        <span class="hidden sm:inline-block sm:align-middle sm:h-screen"
              aria-hidden="true">&#8203;
        </span>

        {# Modal box #}
        <div class="inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
            <div class="sm:flex sm:items-start">
                <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12  sm:mx-0 sm:h-10 sm:w-10">
                    {{ icon("exclamation-triangle", class="h-32 w-32 text-red-600") }}
                </div>
                <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                    <h3 class="text-lg leading-6 font-medium text-black"
                        id="alert-modal-title">
                        Signaler ce contenu
                    </h3>
                    <div class="mt-1">
                        <p class="text-sm text-gray-700"
                           title="{{ post.title }}">
                            {{ post.title }}
                        </p>
                    </div>
                </div>
            </div>

            <form
                class="mt-4 space-y-4"
                hx-post="{{ url_for('wire.alert_submit', post_id=post.id) }}"
                hx-target="#content-alert-modal"
                hx-swap="delete"
                x-data="{
                        selectedReasons: [],
                        message: '',
                        get onlyAutre() {
                        return this.selectedReasons.length === 1 && this.selectedReasons[0] === 'autre';
                        },
                        get isValid() {
                        if (this.selectedReasons.length === 0) return false;
                        if (this.onlyAutre && !this.message.trim()) return false;
                        return true;
                        }
                        }"
            >
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-sm font-medium text-gray-700">
                            Motifs du signalement
                        </label>
                    </div>
                    <div class="space-y-1.5 max-h-52 overflow-y-auto border border-gray-300 rounded-md p-2.5 bg-gray-50/50 divide-y divide-gray-100">
                        {% for code, label in alert_reasons.items() %}
                            <label for="alert-reason-{{ code }}"
                                   class="flex items-center pt-1.2 first:pt-0 cursor-pointer hover:bg-gray-100/70 p-1 rounded transition-colors">
                                <input
                                    id="alert-reason-{{ code }}"
                                    name="reasons"
                                    type="checkbox"
                                    value="{{ code }}"
                                    x-model="selectedReasons"
                                    class="h-4 w-4 border-gray-600 rounded cursor-pointer"
                                >
                                <span class="ml-2.5 text-sm text-gray-900 select-none">
                                    {{ label }}
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <div>
                    <label for="alert-message"
                           class="block text-sm font-medium text-gray-700">
                        Détails
                    </label>
                    <textarea
                        id="alert-message"
                        name="message"
                        rows="3"
                        x-model="message"
                        :required="onlyAutre"
                        :placeholder="onlyAutre ? 'Veuillez préciser la raison de votre signalement (obligatoire)' : 'Vous pouvez donner plus de détails sur le signalement'"
                        class="mt-1 block w-full shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm border border-gray-300 rounded-md p-2"
                    ></textarea>
                </div>

                <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse sm:space-x-reverse sm:space-x-3">
                    <button
                        type="submit"
                        :disabled="!isValid"
                        :class="isValid ? 'bg-red-600 hover:bg-red-700 cursor-pointer' : 'bg-red-300 cursor-not-allowed opacity-60'"
                        class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 text-base font-medium text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm transition-opacity"
                    >
                        Signaler
                    </button>
                    <button
                        type="button"
                        class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:mt-0 sm:w-auto sm:text-sm"
                        onclick="document.getElementById('content-alert-modal')?.remove()"
                    >
                        Annuler
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
