{% extends "pages/preferences/_base.j2" %}

{% block main %}
  <h2>Notifications</h2>

  <h3>
    Quels emails souhaitez-vous recevoir ?
  </h3>

  <p>
    Décochez ce que vous ne voulez plus recevoir par email. Vous continuerez
    à le voir dans vos notifications en vous connectant.
  </p>

  {# PRF-06 — sans cette phrase, un membre qui décoche tout croira avoir
     tout coupé, et s'étonnera de recevoir encore une facture. #}
  <p class="text-sm text-gray-500">
    Les messages liés à votre compte, à vos paiements et aux décisions qui
    vous concernent vous sont toujours envoyés.
  </p>

  <div class="mt-8">
    <form
        class="mt-8 divide-y divide-gray-200 lg:col-span-9 w-4/5"
        action=""
        method="POST"
    >
      <div class="space-y-6">
        {% for category, label, help_text, enabled in categories %}
          <div class="flex items-start gap-3">
            <input
                type="checkbox"
                id="{{ category }}"
                name="{{ category }}"
                class="mt-1"
                {% if enabled %}checked{% endif %}>
            <label for="{{ category }}">
              <span class="font-medium text-gray-900">{{ label }}</span>
              <span class="block text-sm text-gray-500">{{ help_text }}</span>
            </label>
          </div>
        {% endfor %}
      </div>

      <div class="mt-4 py-4 px-4 flex justify-end sm:px-6">
        <button
            type="submit"
            name="submit"
            value="cancel"
            class="bg-white border border-gray-300 rounded-md shadow-sm py-2 px-4 inline-flex justify-center text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500"
        >
          Annuler
        </button>
        <button
            type="submit"
            name="submit"
            value="save"
            class="ml-5 bg-sky-700 border border-transparent rounded-md shadow-sm py-2 px-4 inline-flex justify-center text-sm font-medium text-white hover:bg-sky-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500"
        >
          Enregistrer
        </button>
      </div>
    </form>
  </div>
{% endblock %}
