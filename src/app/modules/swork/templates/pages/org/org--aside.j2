{% from "macros/swork/_macros.j2" import format_activity %} {% macro box(title,
class="") %}
<div class="bg-white mt-6 shadow sm:rounded-md">
    <h2 class="bg-gray-200 sm:rounded-t-md px-4 py-3 font-medium text-gray-800">
        {{ title }}
    </h2>

    <div class="px-4 py-3">{{ caller() }}</div>
</div>
{% endmacro %}

{# Bug 0246 : list of marketplace offers the org has published. #}
{% macro offer_box(title, offers, endpoint) %}
    {% if offers %}
        {% call box(title) %}
            <ul class="space-y-2">
                {% for offer in offers %}
                    <li class="text-sm">
                        <a href="{{ url_for(endpoint, id=offer.id) }}"
                           class="text-blue-700 hover:underline">{{ offer.title }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endcall %}
    {% endif %}
{% endmacro %}

