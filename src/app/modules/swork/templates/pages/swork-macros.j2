{% macro make_post(post) %}
    <li id="post-{{ post.id }}" class="bg-white px-4 py-6 shadow sm:p-6 sm:rounded-lg">
        <article>
            <div>
                <div class="flex space-x-3">
                    <div class="flex-shrink-0">
                        <a href="{{ url_for(post.owner) }}">
                            {{ profile_image(post.owner, size=10) }}
                        </a>
                    </div>

                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium text-gray-900">
                            <a href="{{ url_for(post.owner) }}" class="hover:underline">{{ post.owner.full_name }}</a>
                        </p>

                        <p class="text-sm text-gray-500">
                            <time datetime="{{ post.date.isoformat() }}">
                                {{ post.date.to('Europe/Paris').format('[Le] DD MMM YYYY [à] HH:mm', locale='fr') }}
                            </time>
                            {% if post.original_url %}
                                · publié à l'origine sur
                                <a href="{{ post.original_url }}" class="hover:underline" target="_blank" rel="noopener nofollow">{{ post.original_host }}</a>
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>

            {# `text` is plain text: `linkify` escapes it (bug #0126). #}
            <div class="mt-2 text-sm text-gray-700 whitespace-pre-line" style="overflow-wrap: anywhere">{{ post.text|linkify }}</div>

            {% if post.images %}
                <div class="mt-4 grid gap-2 grid-cols-1 md:grid-cols-2">
                    {% for image in post.images %}
                        <a href="{{ image.url }}" target="_blank" rel="noopener">
                            <img src="{{ image.url }}" alt="{{ image.caption }}" loading="lazy" class="rounded w-full">
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="mt-6 flex justify-between space-x-8">
                <div class="flex space-x-6">
                    <span class="inline-flex items-center text-sm">
                        <button
                            type="button"
                            class="inline-flex space-x-2 text-gray-400 hover:text-gray-500"
                            hx-post="{{ url_for('api.likes', id=post.id, cls='post') }}"
                            hx-vals='{"action": "toggle", }'
                            hx-target="#likes-{{ post.id }}"
                            hx-swap="innerHTML"
                        >
                            {{ icon("hand-thumb-up", class="h-5 w-5") }}
                            <span id="likes-{{ post.id }}" class="font-medium text-gray-900">{{ post.like_count }}</span>
                            <span class="sr-only">likes</span>
                        </button>
                    </span>

                    <span class="inline-flex items-center text-sm"
                          title="Signaler ce contenu">
                        <button
                            type="button"
                            class="inline-flex space-x-2 text-gray-400 hover:text-gray-500"
                            hx-get="{{ url_for('swork.alert_modal', post_id=post.id) }}"
                            hx-target="body"
                            hx-swap="beforeend"
                        >
                            {{ icon("exclamation-triangle", class="h-5 w-5") }}
                            <span class="sr-only">Signaler ce contenu</span>
                        </button>
                    </span>

                    {% if post.owner_id == g.user.id %}
                        <span class="inline-flex items-center text-sm" title="Supprimer ce message">
                            <button
                                type="button"
                                class="inline-flex space-x-2 text-gray-400 hover:text-gray-500"
                                hx-post="{{ url_for('swork.delete_post', post_id=post.id) }}"
                                hx-confirm="Supprimer ce message ?"
                                hx-target="#post-{{ post.id }}"
                                hx-swap="outerHTML"
                            >
                                {{ icon("trash", class="h-5 w-5") }}
                                <span class="sr-only">Supprimer ce message</span>
                            </button>
                        </span>
                    {% endif %}
                </div>
            </div>
        </article>
    </li>
{% endmacro %}

{# `query` keeps the other parameters; `attr` is how the link is followed. #}
{% macro page_links(page, query="", attr="href") %}
    {% if page.has_previous or page.has_next %}
        <nav class="mt-6 flex justify-between text-sm" aria-label="Pages">
            <span>
                {% if page.has_previous %}
                    <a {{ attr }}="?{{ query }}page={{ page.number - 1 }}" class="cursor-pointer text-blue-600 hover:underline">Plus récents</a>
                {% endif %}
            </span>
            <span>
                {% if page.has_next %}
                    <a {{ attr }}="?{{ query }}page={{ page.number + 1 }}" class="cursor-pointer text-blue-600 hover:underline">Plus anciens</a>
                {% endif %}
            </span>
        </nav>
    {% endif %}
{% endmacro %}
