# The build context of ./Dockerfile and tests/docker/Dockerfile: only what they
# copy, as the repo root also holds local data, .venv, node_modules...
#
# One file for both: the classic builder (Docker without buildx) ignores a
# <name>.dockerignore placed next to a Dockerfile.
*
!pyproject.toml
!uv.lock
!README.md
!wsgi.py
!etc
# The only versioned file there.
!bootstrap_data/Ontologies.ods
!icons
!migrations
!scripts
!static-pages
!vite/dist
!sdk/python
!src
!tests

# Local files inside the above.
etc/secrets.toml
scripts/hop3-config.local.sh
migrations/.coverage
icons/git
src/instance
**/.DS_Store
**/*.sqlite*
**/.env*
**/__pycache__
**/*.egg-info
**/.ruff_cache
